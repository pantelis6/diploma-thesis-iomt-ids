*.ipynb_checkpoints
*-checkpoint.ipynb

# ===========================================================
#  Raw datasets (CIC datasets are licensed by the Canadian
#  Institute for Cybersecurity – redistribution is not allowed
#  and the volume exceeds GitHub's repo size limits)
# ===========================================================
data/raw/

# ===========================================================
#  Processed datasets (very large CSV/Parquet/joblib > GitHub
#  100 MB per-file limit and ~1 GB repo recommendation;
#  fully regenerable from the raw data + pipeline code)
# ===========================================================
data/processed/*.csv
data/processed/**/*.csv
data/processed/*.parquet
data/processed/**/*.parquet
data/processed/hospnet26_processed.joblib

# ===========================================================
#  Trained models & evaluation artifacts
#  (some .joblib files reach 11 GB; trained models can also
#  expose sensitive properties of the training data)
# ===========================================================
results/

# ===========================================================
#  Personal / personalised template files
# ===========================================================
TFM_helpful_reference_for_Pantelis_template.pdf

# ===========================================================
#  Redundant archives – content already present unzipped
# ===========================================================
report.zip
sechealth-paper-overleaf.zip

